# Configuration of the Arnakoff commands (internal/platform/config).
# Copy to .env and pass it with `docker run --env-file .env`; the commands
# read the environment only, they do not load this file themselves.
# An unset variable takes the default shown; a variable set to an empty
# string is invalid, unless its comment says otherwise.

# TCP address of the HTTP API, host:port with a numeric port.
# An empty host listens on every interface.
ARNAKOFF_ADDR=:8100

# Minimum log level: debug, info, warn or error.
ARNAKOFF_LOG_LEVEL=info

# Secret HMAC key that pseudonymises emails, phone numbers and IBANs in the
# log. Required, at least 32 bytes in hex. Generate one with:
#   openssl rand -hex 32
# Never commit a real key.
ARNAKOFF_LOG_KEY=

# The only directory the commands write to (snapshots under snapshots/).
# Mount it as the data volume; the rest of the file system can be read-only.
ARNAKOFF_DATA_DIR=var

# Scaleway Object Storage bucket (fr-par) the api and sync commands store
# the snapshots in instead of the data directory: the production store
# (ADR 0005), where they share no volume. Set the bucket and both keys, or
# none: unset, the snapshots stay under ARNAKOFF_DATA_DIR. The name is 3 to
# 63 lower-case letters, digits and inner dashes. Give sync a key pair that
# can read and write this bucket only, and api one that can only read it.
# The keys are secrets, never logged.
# ARNAKOFF_SNAPSHOT_BUCKET=arnakoff-snapshots
# ARNAKOFF_SNAPSHOT_BUCKET_ACCESS_KEY=
# ARNAKOFF_SNAPSHOT_BUCKET_SECRET_KEY=

# Turns the ACPR blacklist on: true or false. Off until its reuse licence
# is obtained (docs/sources.md).
ARNAKOFF_SOURCE_ACPR=false

# HTTPS URL a failed or rejected sync is posted to, as JSON (see
# internal/adapter/alert). Unset or empty, the only exception to the rule
# above: alerts are only logged. It usually carries a credential: treat it
# as a secret.
# ARNAKOFF_ALERT_WEBHOOK=https://hooks.example.net/services/...

# HTTPS URL of the documentation of the API's errors, ending with a slash:
# the "type" of an RFC 9457 problem is its code under it, such as
# https://arnakoff.com/docs/erreurs/invalid_input. Change it for a staging
# site only.
ARNAKOFF_PROBLEM_BASE_URL=https://arnakoff.com/docs/erreurs/

# Most items POST /v1/check/batch accepts, from 1 to 1000; a larger batch is
# refused with too_many_items. The request body may be up to 1 KiB per item,
# and at least 64 KiB.
ARNAKOFF_BATCH_MAX_ITEMS=50

# PostgreSQL connection string of the API key store (ADR 0004). Required by
# the api and admin commands; unset or empty, the other commands run without
# it. Beyond the local machine it must use sslmode=verify-full. It holds a
# password: treat it as a secret. Give the api a role that can only read
# and write its tables, and run `admin migrate` with a distinct role.
# ARNAKOFF_DATABASE_URL=postgres://arnakoff_api:...@db.example.eu:5432/arnakoff?sslmode=verify-full

# Certificate authority of the database, in PEM, used instead of the
# system's to verify it: that of a managed database instance, which a
# container cannot mount as the file sslrootcert names. Not with
# sslrootcert in ARNAKOFF_DATABASE_URL. Leave it empty otherwise.
ARNAKOFF_DATABASE_CA=

# Secret HMAC key the API keys are digested with before they are stored:
# never in the database. Required by the api and admin commands, at least
# 32 bytes in hex, different from ARNAKOFF_LOG_KEY. Changing it invalidates
# every issued key. Generate one with:
#   openssl rand -hex 32
# ARNAKOFF_API_KEY_SECRET=

# Environment of the API keys accepted by the api and issued by default by
# `admin key create`: live (ark_live_…) in production, test (ark_test_…)
# in staging and development.
ARNAKOFF_API_KEY_ENV=live

# Requests per minute, from 1 to 10000, of each API key on the check routes
# and of each client address (IPv6: its /64) on the routes needing no key.
# Kept in memory, per instance. Over the limit, the api answers 429 with
# Retry-After and the RateLimit fields.
ARNAKOFF_RATE_LIMIT_KEY=60
ARNAKOFF_RATE_LIMIT_IP=30

# Refused API keys (malformed, unknown or revoked) per minute, from 1 to
# 10000, of each client address on the check routes. Over it, the address
# is answered 429 without its keys being looked up in the database.
ARNAKOFF_RATE_LIMIT_AUTH=30

# Proxies in front of the api, as comma-separated CIDR prefixes: their
# X-Forwarded-For field then tells the client's address. "none" when no
# proxy stands in front. Required by the api with live keys.
ARNAKOFF_TRUSTED_PROXIES=none

# Demo access of the site's checker, POST /v1/demo/check: no API key, a
# Cloudflare Turnstile token per request. Set both to turn it on, or
# neither. The origin is the only one CORS allows, "https://host" in lower
# case; the secret is the secret key of the site's Turnstile widget, whose
# valid tokens must name the origin's host.
ARNAKOFF_DEMO_ORIGIN=
ARNAKOFF_TURNSTILE_SECRET=

# Demo checks per minute, from 1 to 10000: of each client address, and of
# every client together.
ARNAKOFF_RATE_LIMIT_DEMO=10
ARNAKOFF_RATE_LIMIT_DEMO_GLOBAL=300
